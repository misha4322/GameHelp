{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:ports": "kill-port 3000 3001",
    "dev": "npm run clean:ports && concurrently -k -n next,api -c blue,magenta \"next dev -p 3000\" \"cross-env API_PORT=3001 tsx watch ./src/server/start.ts\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "cross-env API_PORT=3001 tsx watch ./src/server/start.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres minio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build": "next build",
    "start": "npm run clean:ports && concurrently -k -n next,api -c blue,magenta \"next start -p 3000\" \"cross-env API_PORT=3001 tsx ./src/server/start.ts\"",
    "start:web": "next start -p 3000",
    "start:api": "cross-env API_PORT=3001 tsx ./src/server/start.ts",
    "demo": "next build && npm run clean:ports && concurrently -k -n next,api -c blue,magenta \"next start -p 3000\" \"cross-env API_PORT=3001 tsx ./src/server/start.ts\"",
    "moderation:import": "tsx ./scripts/import-moderation-words.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/s3-request-presigner": "^3.1030.0",
    "@elysiajs/node": "^1.4.0",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.22",
    "lucide-react": "^0.563.0",
    "next": "^15.5.12",
    "next-auth": "^4.24.13",
    "next-auth-steam": "^0.4.0",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "simplebar-react": "^3.3.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.0.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^15.5.12",
    "kill-port": "^2.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
